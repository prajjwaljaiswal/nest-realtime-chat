<html>

  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <title>:: Generate OTP :: </title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <style type='text/css'>
      body { background-color: #f9fafb; margin: 0; } .logo {width: 100px;}
    </style>
  </head>

  <body style='padding: 33px 0;'>
    <table
      width='576'
      border='0'
      align='center'
      cellpadding='0'
      cellspacing='0'
    >
      <tr>
        <td bgcolor='#FFFFFF' style='padding: 23px'>
          <table
            width='100%'
            border='0'
            align='center'
            cellpadding='0'
            cellspacing='0'
          >
            <tr>
              <td align='center'>
                <a href='{{clientUrl}}'>
                  <img
                    src='{{body.logoUrl}}'
                    style='width: 100px;'
                    alt='Base Logo'
                  />
                </a>
              </td>
            </tr>
            <tr>
              <td height='55' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                align='center'
                style="color:#000000; font-family: 'Inter', sans-serif; line-height:32px; font-weight:600; font-size:24px"
              >
                Your OTP Code
              </td>
            </tr>
            <tr>
              <td height='25' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >
                You requested an OTP for verification. Your OTP is:
              </td>
            </tr>
            <tr>
              <td height='26' style='font-size:0px'></td>
            </tr>
            <tr>
              <td align='center'>
                <span
                  style='font-size:24px; font-weight:bold; color:#009d33;'
                >{{{body.otp}}}</span>
              </td>
            </tr>
            <tr>
              <td height='22' style='font-size:0'></td>
            </tr>
            <tr>
              <td
                valign='top'
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >
                If you didn't request this, please ignore this email.
              </td>
            </tr>
            <tr>
              <td height='16' style='font-size:0'></td>
            </tr>
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >
                This OTP is valid for a short period. Please use it promptly.
              </td>
            </tr>
            <tr>
              <td height='24' style='font-size:0px'></td>
            </tr>
            <tr>
              <td height='65' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style='background-color:#EAECF0; height:1px; font-size: 0;'
              ></td>
            </tr>
            <tr>
              <td height='32' style='font-size:0px'></td>
            </tr>

            <tr>
              <td height='13' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style="font-family: 'Inter', sans-serif; font-size:14px; line-height:20px; color:#696969;"
              >
                © 2025 Base
              </td>
            </tr>
            <tr>
              <td height='10' style='font-size:0px'></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>

</html>