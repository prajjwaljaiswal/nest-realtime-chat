<html>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=utf-8' />
    <title>:: Reset Password :: </title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400;500;600;700&display=swap'
      rel='stylesheet'
    />
    <style type='text/css'>
      body { background-color: #f9fafb; margin-left: 0px; margin-top: 0px;
      margin-right: 0px; margin-bottom: 0px; } .logo {width: 100px;}
    </style>
  </head>

  <body style='padding:33px 0px; '>
    <table
      width='576'
      border='0'
      align='center'
      cellpadding='0'
      cellspacing='0'
    >
      <tr>
        <td bgcolor='#FFFFFF' style='padding:23px'><table
            width='100%'
            border='0'
            align='center'
            cellpadding='0'
            cellspacing='0'
          >
            <tr>
              <td align='center'><a href='{{clientUrl}}'><img
                    src='{{logoPath}}'
                    style='width: 100px;'
                    alt=''
                  /></a></td>
            </tr>
            <tr>
              <td height='55' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                align='center'
                style="color:#000000; font-family: 'Inter', sans-serif; line-height:32px; font-weight:600; font-size:24px"
              >Verify User</td>
            </tr>
            {{! <tr>
              <td height='25' style='font-size:0px'></td>
            </tr> }}
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >Hi {{{body.name}}}, </td>
            </tr>
            <tr>
              <td height='16' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >You has requested a link to Create new password. You can do this
                through the link below.</td>
            </tr>
            <tr>
              <td height='26' style='font-size:0px'></td>
            </tr>
            <tr>
              <td><table
                  width='208'
                  border='0'
                  align='left'
                  cellpadding='0'
                  cellspacing='0'
                >
                  <tr>
                    <td
                      align='center'
                      style="background-color:#009d33; color:#fff; text-decoration:none; border-radius:8px; padding:6px 2px; height: 32px; font-size:16px; font-family: 'Inter', sans-serif; "
                    ><a
                        href='{{{body.url}}}'
                        target='_blank'
                        style='color:#fff; text-decoration:none;  display:block;'
                      ><strong
                          style='color:#ffffff; font-weight:600; text-decoration:none;'
                        >Create my password</strong></a>
                    </td>
                  </tr>
                </table></td>
            </tr>
            <tr>
              <td height='22' style='font-size:0'></td>
            </tr>
            <tr>
              <td
                valign='top'
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >
                If you didn't request this, please ignore this email.
              </td>
            </tr>
            <tr>
              <td height='16' style='font-size:0'></td>
            </tr>
            <tr>
              <td
                valign='top'
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >

                Your password won't change until you access the link above and
                create a new one.</td>
            </tr>

            <tr>
              <td height='24' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >Thanks,</td>
            </tr>
            <tr>
              <td
                style="color:#344054; font-family: 'Inter', sans-serif; font-size:16px; line-height:24px"
              >Base</td>
            </tr>
            <tr>
              <td height='65' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style='background-color:#EAECF0; height:1px; font-size: 0;'
              ></td>
            </tr>
            <tr>
              <td height='32' style='font-size:0px'></td>
            </tr>

            <tr>
              <td height='13' style='font-size:0px'></td>
            </tr>
            <tr>
              <td
                style="font-family: 'Inter', sans-serif; font-size:14px; line-height:20px; color:#696969;"
              >© 2024 Base
              </td>
            </tr>

            <tr>
              <td height='10' style='font-size:0px'></td>
            </tr>

          </table></td>
      </tr>
    </table>
  </body>
</html>